pragma solidity ^0.8.25;

import "@fhenixprotocol/cofhe-contracts/FHE.sol";

contract CastBasic {
    ebool flag;
    euint32 amount;

    function setFlag() public {
        flag = ebool(true);
    }

    function setAmount() public {
        amount = euint32(5);
    }
}
