pragma solidity ^0.8.25;

import "@fhenixprotocol/cofhe-contracts/FHE.sol";

contract R {
    euint32 a;
    euint32 b;
    euint8 a8;
    ebool eb;
    uint256 plainState;
    mapping(uint256 => euint32) byId;

    event Ping(uint256 x);

    function stateWriter() internal {
        plainState = 1;
    }

    function f(uint32 p, uint32 q, address addr) public {
        if (eb) { byId[p] = a; } else { byId[q] = b; }
    }
}
