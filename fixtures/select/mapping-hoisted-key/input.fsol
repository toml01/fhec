pragma solidity ^0.8.25;

import "@fhenixprotocol/cofhe-contracts/FHE.sol";

contract MappingHoistedKey {
    euint32 a;
    ebool eb;
    mapping(address => euint32) balances;

    function f(address who) public {
        if (eb) {
            balances[who] = a;
        }
    }
}
