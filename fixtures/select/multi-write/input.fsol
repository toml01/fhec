pragma solidity ^0.8.25;

import "@fhenixprotocol/cofhe-contracts/FHE.sol";

contract MultiWrite {
    euint32 a;
    euint32 b;
    ebool eb;

    function f() public {
        if (eb) {
            a = b;
            a = a + 1;
        } else {
            a = b;
        }
    }
}
