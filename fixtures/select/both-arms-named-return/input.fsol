pragma solidity ^0.8.25;

import "@fhenixprotocol/cofhe-contracts/FHE.sol";

contract BothArmsNamedReturn {
    function bothArms(ebool success, euint64 difference) external returns (euint64 res) {
        if (success) {
            res = difference;
        } else {
            res = euint64(0);
        }
    }
}
