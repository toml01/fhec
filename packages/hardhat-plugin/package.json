{
  "name": "@fhec/hardhat-plugin",
  "version": "0.1.0",
  "description": "Hardhat 2 plugin: transpile .fsol with fhec before compile and remap solc diagnostics to original sources",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
