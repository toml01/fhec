    "hardhat": "2.29.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toml01/fhec.git",
    "directory": "packages/hardhat-plugin"
  },
  "homepage": "https://github.com/toml01/fhec/tree/main/packages/hardhat-plugin",
