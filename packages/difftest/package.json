{
  "name": "difftest",
  "version": "0.0.0",
  "private": true,
  "description": "Differential-execution test harness for the fhec transpiler: runs identical transaction sequences against a transpiled contract and a hand-written reference contract on the CoFHE mocks, then asserts plaintext and ACL parity.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:dialect": "node scripts/build-dialect.mjs",
    "test": "node scripts/build-dialect.mjs && hardhat test",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cofhe/mock-contracts": "0.7.0",
    "@fhenixprotocol/cofhe-contracts": "0.1.5",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/chai": "4.3.20",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.5",
    "chai": "4.5.0",
    "chai-as-promised": "8.0.2",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
